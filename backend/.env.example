# Non-secret runtime settings only.
# Database URLs and passwords are loaded from a user-local DPAPI credential store
# by scripts/Load-LocalDbEnvironment.ps1 and are never committed to source control.
SAKHI_ENV=dev
NODE_ENV=development
HOST=127.0.0.1
PORT=3001 # Local Google Drive OAuth callback and media API
LOG_LEVEL=info

# Google Drive media integration. Configure secrets in the private host environment,
# never in Flutter, source control, or shared screenshots.
# SAKHI_GOOGLE_DRIVE_CLIENT_ID=
# SAKHI_GOOGLE_DRIVE_CLIENT_SECRET=
# SAKHI_GOOGLE_DRIVE_REFRESH_TOKEN=
# Local development defaults to the Windows DPAPI-backed callback.
# Staging Render uses the public HTTPS URI and a guarded manual env-var handoff:
# SAKHI_GOOGLE_DRIVE_REDIRECT_URI=https://sakhi-staging-api.onrender.com/api/v1/integrations/google-drive/callback
SAKHI_GOOGLE_DRIVE_CLOUD_SETUP_ENABLED=false
SAKHI_GOOGLE_DRIVE_ROOT_FOLDER_NAME=Sakhi Media

# Optional wellness audio object CDN. Populate the 42 catalogue MP3 objects at the
# matching wellness-audio/v1/ paths before enabling this; the backend verifies
# each object against catalogue MIME type, byte size and SHA-256.
# SAKHI_WELLNESS_AUDIO_CDN_BASE_URL=https://<your-public-audio-cdn-origin>

# Local start-dev.ps1 enables this explicitly. Never enable it for production.
SAKHI_OTP_MODE=disabled
# Set only by the dev wrapper. This is not approved production age policy.
SAKHI_PREVIEW_MINIMUM_AGE_YEARS=


# SAKHI_ADMIN_CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Manual submissions remain disabled unless policy and external evidence procedure are explicitly approved.
# SAKHI_MANUAL_REVIEW_POLICY_APPROVED=false
# SAKHI_MANUAL_REVIEW_EVIDENCE_PROCEDURE_APPROVED=false
# SAKHI_MANUAL_REVIEW_CONSENT_VERSION=
# SAKHI_MANUAL_REVIEW_CONSENT_TEXT=
# SAKHI_MANUAL_REVIEW_DESCRIPTION=
# SAKHI_MANUAL_REVIEW_DATA_HANDLING_DESCRIPTION=
# SAKHI_MANUAL_REVIEW_RETENTION_DESCRIPTION=

# Hosted friend-test mode only. Configure these in Render's protected environment;
# never enable this mode on the public production service or put values in Flutter/Git.
# SAKHI_OTP_MODE=staging_test
# SAKHI_STAGING_TEST_PHONE_ALLOWLIST=+91*  # staging test only; unsafe for real accounts
# SAKHI_STAGING_TEST_OTP_CODE=<six-digit shared code stored only in the backend host>
# SAKHI_STAGING_TEST_MINIMUM_AGE_YEARS=18
#
# Individual staging staff authentication (required by every staging deployment).
# Generate TWO independent keys with: openssl rand -base64 32
# Store each only in the backend host's protected environment; never commit or expose them.
# SAKHI_ADMIN_STAFF_SESSION_SIGNING_KEY=<base64-encoded 32-byte random key>
# SAKHI_ADMIN_MFA_ENCRYPTION_KEY=<different base64-encoded 32-byte random key>
# Versioned rotation: keep every old key configured until all stored MFA records are re-encrypted.
# SAKHI_ADMIN_MFA_ENCRYPTION_KEY_VERSION=v1
# SAKHI_ADMIN_MFA_ENCRYPTION_KEY_V1=<base64-encoded 32-byte key for version v1>
# SAKHI_ADMIN_MFA_ENCRYPTION_KEY_V2=<new base64-encoded 32-byte key for version v2>
# The following credential is ONLY for one-time initial Super Admin bootstrap.
# It cannot log in, establish a session, or authorize any staff-management action.
# SAKHI_STAGING_FULL_ADMIN_ENABLED=true
# SAKHI_STAGING_FULL_ADMIN_TOKEN=<one-time bootstrap credential; at least 32 random characters>
# SAKHI_ADMIN_CORS_ORIGIN=https://sakhi-super-admin.onrender.com
# Legacy reviewer-token variables and their enable flags are obsolete and must not be configured.
# All privileged staff operations require an individual persistent MFA-verified session.
# The staging app's database URL uses sslmode=verify-full&sslrootcert=prod-ca-2021.crt.


# Decentro DigiLocker staging integration (server-side only).
# Enter credentials in the private backend runtime environment or hosting secret store.
# Never commit real credentials or copy them into Flutter/Super-Admin sources.
DECENTRO_BASE_URL=https://in.staging.decentro.tech
DECENTRO_CLIENT_ID=
DECENTRO_CLIENT_SECRET=
DECENTRO_KYC_MODULE_SECRET=
APP_VERIFICATION_CALLBACK_URL=
# Optional only for a separately confirmed HMAC adapter; standard browser return uses server-side result lookup.
DECENTRO_WEBHOOK_SECRET=
# Keep false until consent wording, privacy/retention policy, and provider flow are approved.
SAKHI_DECENTRO_POLICY_APPROVED=false
# Local-only synthetic simulator: NODE_ENV=development, SAKHI_ENV=dev, HOST=127.0.0.1.
SAKHI_ENABLE_LOCAL_ELIGIBILITY_SIMULATOR=false
# Separate staging-only synthetic test path; only enable on the dedicated Sakhi staging API.
SAKHI_ENABLE_STAGING_ELIGIBILITY_DEMO=false

# Server-to-server GitHub Actions retention trigger (generate >=32 random bytes).
SAKHI_EVIDENCE_RETENTION_CRON_TOKEN=
SAKHI_EVIDENCE_RETENTION_WORKER_ENABLED=false

# Disabled by default; enable only for controlled staging synthetic-account tests.
SAKHI_SYNTHETIC_FIXTURE_ENABLED=false
