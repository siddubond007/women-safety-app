# Non-secret runtime settings only.
# Database URLs and passwords are loaded from a user-local DPAPI credential store
# by scripts/Load-LocalDbEnvironment.ps1 and are never committed to source control.
SAKHI_ENV=dev
NODE_ENV=development
HOST=127.0.0.1
PORT=3001 # Local Google Drive OAuth callback and media API
LOG_LEVEL=info

# Local start-dev.ps1 enables this explicitly. Never enable it for production.
SAKHI_OTP_MODE=disabled
# Set only by the dev wrapper. This is not approved production age policy.
SAKHI_PREVIEW_MINIMUM_AGE_YEARS=


# Local dev/test-only Super Admin reviewer gate. Never put these in VITE_* variables.
# Set SAKHI_ADMIN_REVIEW_TOKEN only in the backend process; generate a random secret of 32+ characters.
# SAKHI_ADMIN_REVIEW_TOKEN=
# SAKHI_ADMIN_REVIEWER_LABEL=Local Eligibility Reviewer
# SAKHI_ADMIN_CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Manual submissions remain disabled unless policy and external evidence procedure are explicitly approved.
# SAKHI_MANUAL_REVIEW_POLICY_APPROVED=false
# SAKHI_MANUAL_REVIEW_EVIDENCE_PROCEDURE_APPROVED=false
# SAKHI_MANUAL_REVIEW_CONSENT_VERSION=
# SAKHI_MANUAL_REVIEW_CONSENT_TEXT=
# SAKHI_MANUAL_REVIEW_DESCRIPTION=
# SAKHI_MANUAL_REVIEW_DATA_HANDLING_DESCRIPTION=
# SAKHI_MANUAL_REVIEW_RETENTION_DESCRIPTION=

# Hosted friend-test mode only. Configure these in Render's protected environment;
# never enable this mode on the public production service or put values in Flutter/Git.
# SAKHI_OTP_MODE=staging_test
# SAKHI_STAGING_TEST_PHONE_ALLOWLIST=+91*  # any valid Indian mobile; staging test only and unsafe for real accounts
# SAKHI_STAGING_TEST_OTP_CODE=<six-digit shared code stored only in the backend host>
# SAKHI_STAGING_TEST_MINIMUM_AGE_YEARS=18
# Staging-only admin access for the shared test database. The flag alone does not
# enable access: NODE_ENV=production, SAKHI_ENV=staging, OTP staging_test, and a
# random SAKHI_ADMIN_REVIEW_TOKEN of at least 32 characters are all required.
# Never use this shared-token gate for production or share its token with testers.
# SAKHI_STAGING_ADMIN_REVIEW_ENABLED=true
# SAKHI_ADMIN_REVIEW_TOKEN=
# SAKHI_ADMIN_REVIEWER_LABEL=Sakhi Staging Test Reviewer
# SAKHI_ADMIN_CORS_ORIGIN=https://sakhi-super-admin.onrender.com
# The staging app's database URL uses sslmode=verify-full&sslrootcert=prod-ca-2021.crt.
