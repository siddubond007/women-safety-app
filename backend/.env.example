# Non-secret runtime settings only.
# Database URLs and passwords are loaded from a user-local DPAPI credential store
# by scripts/Load-LocalDbEnvironment.ps1 and are never committed to source control.
SAKHI_ENV=dev
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Local start-dev.ps1 enables this explicitly. Never enable it for production.
SAKHI_OTP_MODE=disabled
# Set only by the dev wrapper. This is not approved production age policy.
SAKHI_PREVIEW_MINIMUM_AGE_YEARS=


# Local dev/test-only Super Admin reviewer gate. Never put these in VITE_* variables.
# Set SAKHI_ADMIN_REVIEW_TOKEN only in the backend process; generate a random secret of 32+ characters.
# SAKHI_ADMIN_REVIEW_TOKEN=  # local dev/test only; 16 chars minimum, random 32+ chars recommended
# SAKHI_ADMIN_REVIEWER_LABEL=Local Eligibility Reviewer
# SAKHI_ADMIN_CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Manual submissions remain disabled unless policy and external evidence procedure are explicitly approved.
# SAKHI_MANUAL_REVIEW_POLICY_APPROVED=false
# SAKHI_MANUAL_REVIEW_EVIDENCE_PROCEDURE_APPROVED=false
# SAKHI_MANUAL_REVIEW_CONSENT_VERSION=
# SAKHI_MANUAL_REVIEW_CONSENT_TEXT=
# SAKHI_MANUAL_REVIEW_DESCRIPTION=
# SAKHI_MANUAL_REVIEW_DATA_HANDLING_DESCRIPTION=
# SAKHI_MANUAL_REVIEW_RETENTION_DESCRIPTION=
