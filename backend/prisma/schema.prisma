generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  RESTRICTED
  SUSPENDED
  DELETED

  @@map("account_status")
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED

  @@map("verification_status")
}

enum EligibilitySubmissionStatus {
  PENDING_MANUAL_REVIEW
  APPROVED
  REJECTED

  @@map("eligibility_submission_status")
}

enum OtpPurpose {
  LOGIN
  REGISTRATION

  @@map("otp_purpose")
}

enum PolicyDocumentType {
  TERMS
  PRIVACY

  @@map("policy_document_type")
}

enum PolicyDocumentStatus {
  DRAFT
  PUBLISHED
  RETIRED

  @@map("policy_document_status")
}

model MemberAccount {
  id                      String                         @id @default(uuid()) @db.Uuid
  phoneE164               String                         @unique(map: "member_accounts_phone_e164_key") @map("phone_e164") @db.VarChar(16)
  phoneVerifiedAt         DateTime?                      @map("phone_verified_at") @db.Timestamptz(6)
  status                  AccountStatus                  @default(PENDING_VERIFICATION)
  verificationStatus      VerificationStatus             @default(UNVERIFIED) @map("verification_status")
  createdAt               DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  profile                 MemberProfile?
  otpChallenges           OtpChallenge[]
  consents                MemberConsent[]
  sessions                AuthSession[]
  communicationPreference MemberCommunicationPreference?
  eligibilitySubmissions  EligibilitySubmission[]
  communityPosts          CommunityPost[]
  postLikes               CommunityPostLike[]
  postSaves               CommunityPostSave[]
  postComments            CommunityPostComment[]
  follows                 MemberFollow[]
  privacyPreference       MemberPrivacyPreference?
  notificationPreference  MemberNotificationPreference?
  emergencyContacts       SafetyEmergencyContact[]
  sosEvents               SafetySosEvent[]
  moderationBlocks        MemberModerationBlock[]
  userReports             MemberUserReport[]

  @@map("member_accounts")
}

model MemberProfile {
  accountId            String        @id @map("account_id") @db.Uuid
  displayName          String        @map("display_name") @db.VarChar(100)
  username             String?       @unique(map: "member_profiles_username_key") @db.VarChar(50)
  bio                  String        @default("A passionate learner, exploring wellness, technology and meaningful connections. 💜") @db.VarChar(300)
  location             String        @default("Bangalore, India") @db.VarChar(120)
  avatarAsset          String        @default("assets/images/profile/avatar_siddhu.webp") @map("avatar_asset") @db.VarChar(255)
  interests            Json          @default("[\"Mental Wellness\",\"Travel\",\"Reading\",\"WomenInTech\",\"Art\",\"Fitness\"]") @db.JsonB
  businessProfileUrl   String?       @map("business_profile_url") @db.VarChar(255)
  twoFactorEnabled     Boolean       @default(false) @map("two_factor_enabled")
  securityPinUpdatedAt DateTime?     @map("security_pin_updated_at") @db.Timestamptz(6)
  dateOfBirth          DateTime      @map("date_of_birth") @db.Date
  email                String?       @db.VarChar(254)
  profilePhotoRef      String?       @map("profile_photo_ref") @db.VarChar(512)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  account              MemberAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("member_profiles")
}

model OtpChallenge {
  id                String         @id @default(uuid()) @db.Uuid
  accountId         String?        @map("account_id") @db.Uuid
  phoneE164         String         @map("phone_e164") @db.VarChar(16)
  purpose           OtpPurpose
  providerReference String?        @map("provider_reference") @db.VarChar(255)
  codeDigest        String?        @map("code_digest") @db.VarChar(255)
  attemptCount      Int            @default(0) @map("attempt_count")
  attemptLimit      Int            @map("attempt_limit")
  expiresAt         DateTime       @map("expires_at") @db.Timestamptz(6)
  resendAvailableAt DateTime       @map("resend_available_at") @db.Timestamptz(6)
  consumedAt        DateTime?      @map("consumed_at") @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  account           MemberAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([phoneE164, purpose, createdAt], map: "otp_challenges_phone_purpose_created_idx")
  @@index([expiresAt], map: "otp_challenges_expires_at_idx")
  @@index([accountId], map: "otp_challenges_account_id_idx")
  @@map("otp_challenges")
}

model PolicyDocumentVersion {
  id           String               @id @default(uuid()) @db.Uuid
  documentType PolicyDocumentType   @map("document_type")
  version      String               @db.VarChar(64)
  status       PolicyDocumentStatus @default(DRAFT)
  contentHash  String?              @map("content_hash") @db.VarChar(128)
  effectiveAt  DateTime?            @map("effective_at") @db.Timestamptz(6)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  termsFor     MemberConsent[]      @relation("TermsAcceptedVersion")
  privacyFor   MemberConsent[]      @relation("PrivacyAcceptedVersion")

  @@unique([documentType, version], map: "policy_document_versions_type_version_key")
  @@index([documentType, status], map: "policy_document_versions_type_status_idx")
  @@map("policy_document_versions")
}

model MemberConsent {
  id               String                @id @default(uuid()) @db.Uuid
  accountId        String                @map("account_id") @db.Uuid
  termsVersionId   String                @map("terms_version_id") @db.Uuid
  privacyVersionId String                @map("privacy_version_id") @db.Uuid
  acceptedAt       DateTime              @default(now()) @map("accepted_at") @db.Timestamptz(6)
  source           String                @db.VarChar(64)
  account          MemberAccount         @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  termsVersion     PolicyDocumentVersion @relation("TermsAcceptedVersion", fields: [termsVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  privacyVersion   PolicyDocumentVersion @relation("PrivacyAcceptedVersion", fields: [privacyVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([accountId, acceptedAt], map: "member_consents_account_accepted_idx")
  @@index([termsVersionId], map: "member_consents_terms_version_idx")
  @@index([privacyVersionId], map: "member_consents_privacy_version_idx")
  @@map("member_consents")
}

/// Opaque bearer sessions. Only SHA-256 token digests are stored.
model AuthSession {
  id          String        @id @default(uuid()) @db.Uuid
  accountId   String        @map("account_id") @db.Uuid
  tokenDigest String        @unique(map: "auth_sessions_token_digest_key") @map("token_digest") @db.VarChar(64)
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime?     @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt  DateTime?     @map("last_seen_at") @db.Timestamptz(6)
  account     MemberAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([accountId, expiresAt], map: "auth_sessions_account_expiry_idx")
  @@index([expiresAt], map: "auth_sessions_expiry_idx")
  @@map("auth_sessions")
}

/// Stores the current product-update preference separately from required
/// Terms/Privacy acceptance. It is development/test only until its own
/// purpose and policy are approved for production.
model MemberCommunicationPreference {
  accountId              String        @id @map("account_id") @db.Uuid
  productUpdatesAccepted Boolean       @default(false) @map("product_updates_accepted")
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  account                MemberAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("member_communication_preferences")
}

model EligibilitySubmission {
  id                String                      @id @default(uuid()) @db.Uuid
  accountId         String                      @map("account_id") @db.Uuid
  status            EligibilitySubmissionStatus @default(PENDING_MANUAL_REVIEW)
  consentVersion    String                      @map("consent_version") @db.VarChar(64)
  consentAcceptedAt DateTime                    @map("consent_accepted_at") @db.Timestamptz(6)
  submittedAt       DateTime                    @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt        DateTime?                   @map("reviewed_at") @db.Timestamptz(6)
  reviewerLabel     String?                     @map("reviewer_label") @db.VarChar(80)
  decisionReason    String?                     @map("decision_reason") @db.VarChar(500)
  account           MemberAccount               @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([status, submittedAt], map: "eligibility_submissions_status_submitted_idx")
  @@index([accountId, submittedAt], map: "eligibility_submissions_account_submitted_idx")
  @@map("eligibility_submissions")
}

model CommunityPost {
  id                       String                 @id @default(uuid()) @db.Uuid
  authorAccountId          String?                @map("author_account_id") @db.Uuid
  authorName               String                 @map("author_name") @db.VarChar(100)
  authorUsername           String                 @map("author_username") @db.VarChar(50)
  authorAvatar             String                 @map("author_avatar") @db.VarChar(255)
  authorVerified           Boolean                @default(false) @map("author_verified")
  content                  String                 @db.Text
  imageAsset               String?                @map("image_asset") @db.VarChar(255)
  categoryBadge            String?                @map("category_badge") @db.VarChar(64)
  feedSection              String                 @default("community") @map("feed_section") @db.VarChar(32)
  hasBreathingExerciseCard Boolean                @default(false) @map("has_breathing_exercise_card")
  likesCount               Int                    @default(0) @map("likes_count")
  commentsCount            Int                    @default(0) @map("comments_count")
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  authorAccount            MemberAccount?         @relation(fields: [authorAccountId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  likes                    CommunityPostLike[]
  saves                    CommunityPostSave[]
  comments                 CommunityPostComment[]

  @@index([feedSection, createdAt], map: "community_posts_section_created_idx")
  @@index([authorAccountId, createdAt], map: "community_posts_author_created_idx")
  @@map("community_posts")
}

model CommunityPostLike {
  id        String        @id @default(uuid()) @db.Uuid
  postId    String        @map("post_id") @db.Uuid
  accountId String        @map("account_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  account   MemberAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([postId, accountId], map: "community_post_likes_post_account_key")
  @@index([accountId], map: "community_post_likes_account_idx")
  @@map("community_post_likes")
}

model CommunityPostSave {
  id        String        @id @default(uuid()) @db.Uuid
  postId    String        @map("post_id") @db.Uuid
  accountId String        @map("account_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  account   MemberAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([postId, accountId], map: "community_post_saves_post_account_key")
  @@index([accountId], map: "community_post_saves_account_idx")
  @@map("community_post_saves")
}

model CommunityPostComment {
  id         String        @id @default(uuid()) @db.Uuid
  postId     String        @map("post_id") @db.Uuid
  accountId  String        @map("account_id") @db.Uuid
  authorName String        @map("author_name") @db.VarChar(100)
  content    String        @db.VarChar(500)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  post       CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  account    MemberAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([postId, createdAt], map: "community_post_comments_post_created_idx")
  @@map("community_post_comments")
}

model CommunityGroup {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique(map: "community_groups_name_key") @db.VarChar(120)
  description   String   @db.VarChar(300)
  category      String   @db.VarChar(64)
  membersCount  Int      @default(1) @map("members_count")
  newPostsToday Int      @default(0) @map("new_posts_today")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("community_groups")
}

model CommunityDirectoryProfile {
  id               String         @id @default(uuid()) @db.Uuid
  name             String         @db.VarChar(100)
  username         String         @unique(map: "community_directory_profiles_username_key") @db.VarChar(50)
  avatarAsset      String         @map("avatar_asset") @db.VarChar(255)
  bio              String?        @db.VarChar(255)
  defaultFollowing Boolean        @default(false) @map("default_following")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  follows          MemberFollow[]

  @@map("community_directory_profiles")
}

model MemberFollow {
  id                 String                    @id @default(uuid()) @db.Uuid
  accountId          String                    @map("account_id") @db.Uuid
  directoryProfileId String                    @map("directory_profile_id") @db.Uuid
  isFollowing        Boolean                   @default(true) @map("is_following")
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  account            MemberAccount             @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  directoryProfile   CommunityDirectoryProfile @relation(fields: [directoryProfileId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([accountId, directoryProfileId], map: "member_follows_account_profile_key")
  @@index([accountId], map: "member_follows_account_idx")
  @@map("member_follows")
}

model MemberPrivacyPreference {
  accountId         String        @id @map("account_id") @db.Uuid
  viewProfile       String        @default("Verified members only") @map("view_profile") @db.VarChar(64)
  messageMe         String        @default("Verified members only") @map("message_me") @db.VarChar(64)
  seePosts          String        @default("Verified members only") @map("see_posts") @db.VarChar(64)
  showLocation      String        @default("General location only") @map("show_location") @db.VarChar(64)
  searchResults     String        @default("Yes") @map("search_results") @db.VarChar(32)
  businessEnquiries String        @default("Yes") @map("business_enquiries") @db.VarChar(64)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  account           MemberAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("member_privacy_preferences")
}

model MemberNotificationPreference {
  accountId         String        @id @map("account_id") @db.Uuid
  communityUpdates  Boolean       @default(true) @map("community_updates")
  groupActivity     Boolean       @default(true) @map("group_activity")
  wellnessReminders Boolean       @default(true) @map("wellness_reminders")
  safetyAlerts      Boolean       @default(true) @map("safety_alerts")
  messages          Boolean       @default(true) @map("messages")
  businessEnquiries Boolean       @default(true) @map("business_enquiries")
  marketingUpdates  Boolean       @default(false) @map("marketing_updates")
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  account           MemberAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("member_notification_preferences")
}

model SafetyEmergencyContact {
  id                       String        @id @default(uuid()) @db.Uuid
  accountId                String        @map("account_id") @db.Uuid
  name                     String        @db.VarChar(100)
  relationship             String        @db.VarChar(64)
  phoneE164                String        @map("phone_e164") @db.VarChar(16)
  isTrustedLocationContact Boolean       @default(true) @map("is_trusted_location_contact")
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  account                  MemberAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([accountId], map: "safety_emergency_contacts_account_idx")
  @@map("safety_emergency_contacts")
}

model SafetySosEvent {
  id            String        @id @default(uuid()) @db.Uuid
  accountId     String        @map("account_id") @db.Uuid
  eventType     String        @map("event_type") @db.VarChar(32)
  status        String        @default("RECORDED") @db.VarChar(32)
  locationLabel String?       @map("location_label") @db.VarChar(120)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  account       MemberAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([accountId, createdAt], map: "safety_sos_events_account_created_idx")
  @@map("safety_sos_events")
}

model WellnessResource {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique(map: "wellness_resources_slug_key") @db.VarChar(64)
  category      String   @db.VarChar(64)
  title         String   @db.VarChar(150)
  subtitle      String   @db.VarChar(255)
  durationLabel String?  @map("duration_label") @db.VarChar(64)
  thumbAsset    String?  @map("thumb_asset") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("wellness_resources")
}

model MemberModerationBlock {
  id                 String        @id @default(uuid()) @db.Uuid
  accountId          String        @map("account_id") @db.Uuid
  blockedUsername    String        @map("blocked_username") @db.VarChar(50)
  blockedDisplayName String        @map("blocked_display_name") @db.VarChar(100)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  account            MemberAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([accountId, blockedUsername], map: "member_moderation_blocks_account_username_key")
  @@index([accountId], map: "member_moderation_blocks_account_idx")
  @@map("member_moderation_blocks")
}

model MemberUserReport {
  id                String        @id @default(uuid()) @db.Uuid
  reporterAccountId String        @map("reporter_account_id") @db.Uuid
  targetHandle      String        @map("target_handle") @db.VarChar(100)
  reason            String        @db.VarChar(500)
  status            String        @default("SUBMITTED") @db.VarChar(32)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  reporterAccount   MemberAccount @relation(fields: [reporterAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([reporterAccountId, createdAt], map: "member_user_reports_reporter_created_idx")
  @@map("member_user_reports")
}

model AuditEvent {
  id               String   @id @default(uuid()) @db.Uuid
  actorType        String   @map("actor_type") @db.VarChar(32)
  actorId          String?  @map("actor_id") @db.Uuid
  action           String   @map("action") @db.VarChar(128)
  targetType       String?  @map("target_type") @db.VarChar(64)
  targetId         String?  @map("target_id") @db.VarChar(128)
  outcome          String   @db.VarChar(32)
  requestId        String   @map("request_id") @db.VarChar(128)
  redactedMetadata Json?    @map("redacted_metadata") @db.JsonB
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt], map: "audit_events_created_at_idx")
  @@index([actorType, actorId, createdAt], map: "audit_events_actor_created_idx")
  @@index([action, createdAt], map: "audit_events_action_created_idx")
  @@map("audit_events")
}
