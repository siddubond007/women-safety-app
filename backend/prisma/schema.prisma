model MenstrualCycleLog {
  id                 String        @id @default(uuid()) @db.Uuid
  accountId          String        @map("account_id") @db.Uuid
  startDate          DateTime      @map("start_date") @db.Date
  endDate            DateTime?     @map("end_date") @db.Date
  cycleLengthDays    Int?          @map("cycle_length_days")
  periodDurationDays Int?          @map("period_duration_days")
  flowIntensity      String        @default("MEDIUM") @map("flow_intensity") @db.VarChar(24)
  symptoms           Json          @default("[]") @db.JsonB
  mood               String?       @db.VarChar(40)
  energyLevel        Int?          @map("energy_level")
  crampsSeverity     String?       @map("cramps_severity") @db.VarChar(24)
  notesEncrypted     String?       @map("notes_encrypted") @db.Text
  isIrregular        Boolean       @default(false) @map("is_irregular")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  account            MemberAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "menstrual_cycle_logs_account_id_fkey")

  @@index([accountId, startDate], map: "menstrual_cycle_logs_account_start_idx")
  @@map("menstrual_cycle_logs")
}

