model MediaAsset {
  id               String    @id @default(uuid()) @db.Uuid
  ownerAccountId   String    @map("owner_account_id") @db.Uuid
  postId           String?   @map("post_id") @db.Uuid
  purpose          String    @default("COMMUNITY_POST_IMAGE") @db.VarChar(32)
  storageProvider  String    @default("GOOGLE_DRIVE") @map("storage_provider") @db.VarChar(32)
  status           String    @default("UPLOADED") @db.VarChar(32)
  categorySlug     String?   @map("category_slug") @db.VarChar(40)
  driveFileId      String?   @map("drive_file_id") @db.VarChar(160)
  driveFolderId    String?   @map("drive_folder_id") @db.VarChar(160)
  driveFolderPath  String    @map("drive_folder_path") @db.VarChar(500)
  localAssetPath   String?   @map("local_asset_path") @db.VarChar(255)
  originalFileName String    @map("original_file_name") @db.VarChar(255)
  contentType      String    @map("content_type") @db.VarChar(80)
  byteSize         Int       @map("byte_size")
  widthPx          Int?      @map("width_px")
  heightPx         Int?      @map("height_px")
  cropAspectRatio  String    @default("4:5") @map("crop_aspect_ratio") @db.VarChar(16)
  sha256Checksum   String?   @map("sha256_checksum") @db.VarChar(64)
  visibility       String    @default("VERIFIED_MEMBERS") @db.VarChar(32)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  owner MemberAccount  @relation(fields: [ownerAccountId], references: [id], onDelete: Cascade)
  post  CommunityPost? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([ownerAccountId, purpose, status], map: "media_assets_owner_purpose_status_idx")
  @@index([postId, status], map: "media_assets_post_status_idx")
  @@index([driveFileId], map: "media_assets_drive_file_id_idx")
  @@map("media_assets")
}

model CommunityPostReaction {
  id           String   @id @default(uuid()) @db.Uuid
  postId       String   @map("post_id") @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  reactionType String   @default("LIKE") @map("reaction_type") @db.VarChar(32)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  post    CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  account MemberAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([postId, accountId], map: "community_post_reactions_post_account_key")
  @@index([postId, reactionType], map: "community_post_reactions_post_type_idx")
  @@map("community_post_reactions")
}

