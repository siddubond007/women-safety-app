generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  RESTRICTED
  SUSPENDED
  DELETED

  @@map("account_status")
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED

  @@map("verification_status")
}

/// Eligibility for Sakhi's protected community features. This is separate
/// from account lifecycle status and the legacy authentication verification flag.
enum EligibilityVerificationStatus {
  NOT_VERIFIED
  VERIFICATION_IN_PROGRESS
  PENDING_MANUAL_REVIEW
  VERIFIED
  VERIFICATION_FAILED
  TEMPORARILY_RESTRICTED
  REVERIFICATION_REQUIRED

  @@map("eligibility_verification_status")
}

enum EligibilityVerificationSessionStatus {
  CREATED
  REDIRECT_READY
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED

  @@map("eligibility_verification_session_status")
}

enum EligibilityProviderCallbackOutcome {
  VERIFIED
  PENDING_MANUAL_REVIEW
  VERIFICATION_FAILED

  @@map("eligibility_provider_callback_outcome")
}

enum EligibilitySupportRequestCategory {
  VERIFICATION_HELP
  MANUAL_REVIEW_REQUEST
  ACCESSIBILITY_ALTERNATIVE
  APPEAL_GUIDANCE

  @@map("eligibility_support_request_category")
}

enum EligibilitySupportRequestStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED

  @@map("eligibility_support_request_status")
}

enum OtpPurpose {
  LOGIN
  REGISTRATION

  @@map("otp_purpose")
}

enum PolicyDocumentType {
  TERMS
  PRIVACY

  @@map("policy_document_type")
}

enum PolicyDocumentStatus {
  DRAFT
  PUBLISHED
  RETIRED

  @@map("policy_document_status")
}

model MemberAccount {
  id                      String                         @id @default(uuid()) @db.Uuid
  phoneE164               String                         @unique(map: "member_accounts_phone_e164_key") @map("phone_e164") @db.VarChar(16)
  phoneVerifiedAt         DateTime?                      @map("phone_verified_at") @db.Timestamptz(6)
  status                  AccountStatus                  @default(PENDING_VERIFICATION)
  verificationStatus      VerificationStatus             @default(UNVERIFIED) @map("verification_status")
  eligibilityStatus       EligibilityVerificationStatus  @default(NOT_VERIFIED) @map("eligibility_status")
  createdAt               DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  profile                 MemberProfile?
  otpChallenges           OtpChallenge[]
  consents                MemberConsent[]
  sessions                AuthSession[]
  communicationPreference MemberCommunicationPreference?
  eligibilityConsents    EligibilityConsent[]
  eligibilitySessions    EligibilityVerificationSession[]
  eligibilitySupportRequests EligibilitySupportRequest[]

  @@map("member_accounts")
}

model MemberProfile {
  accountId       String        @id @map("account_id") @db.Uuid
  displayName     String        @map("display_name") @db.VarChar(100)
  dateOfBirth     DateTime      @map("date_of_birth") @db.Date
  email           String?       @db.VarChar(254)
  profilePhotoRef String?       @map("profile_photo_ref") @db.VarChar(512)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  account         MemberAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("member_profiles")
}

model OtpChallenge {
  id                String         @id @default(uuid()) @db.Uuid
  accountId         String?        @map("account_id") @db.Uuid
  phoneE164         String         @map("phone_e164") @db.VarChar(16)
  purpose           OtpPurpose
  providerReference String?        @map("provider_reference") @db.VarChar(255)
  codeDigest        String?        @map("code_digest") @db.VarChar(255)
  attemptCount      Int            @default(0) @map("attempt_count")
  attemptLimit      Int            @map("attempt_limit")
  expiresAt         DateTime       @map("expires_at") @db.Timestamptz(6)
  resendAvailableAt DateTime       @map("resend_available_at") @db.Timestamptz(6)
  consumedAt        DateTime?      @map("consumed_at") @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  account           MemberAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([phoneE164, purpose, createdAt], map: "otp_challenges_phone_purpose_created_idx")
  @@index([expiresAt], map: "otp_challenges_expires_at_idx")
  @@index([accountId], map: "otp_challenges_account_id_idx")
  @@map("otp_challenges")
}

model PolicyDocumentVersion {
  id           String               @id @default(uuid()) @db.Uuid
  documentType PolicyDocumentType   @map("document_type")
  version      String               @db.VarChar(64)
  status       PolicyDocumentStatus @default(DRAFT)
  contentHash  String?              @map("content_hash") @db.VarChar(128)
  effectiveAt  DateTime?            @map("effective_at") @db.Timestamptz(6)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  termsFor     MemberConsent[]      @relation("TermsAcceptedVersion")
  privacyFor   MemberConsent[]      @relation("PrivacyAcceptedVersion")

  @@unique([documentType, version], map: "policy_document_versions_type_version_key")
  @@index([documentType, status], map: "policy_document_versions_type_status_idx")
  @@map("policy_document_versions")
}

model MemberConsent {
  id               String                @id @default(uuid()) @db.Uuid
  accountId        String                @map("account_id") @db.Uuid
  termsVersionId   String                @map("terms_version_id") @db.Uuid
  privacyVersionId String                @map("privacy_version_id") @db.Uuid
  acceptedAt       DateTime              @default(now()) @map("accepted_at") @db.Timestamptz(6)
  source           String                @db.VarChar(64)
  account          MemberAccount         @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  termsVersion     PolicyDocumentVersion @relation("TermsAcceptedVersion", fields: [termsVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  privacyVersion   PolicyDocumentVersion @relation("PrivacyAcceptedVersion", fields: [privacyVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([accountId, acceptedAt], map: "member_consents_account_accepted_idx")
  @@index([termsVersionId], map: "member_consents_terms_version_idx")
  @@index([privacyVersionId], map: "member_consents_privacy_version_idx")
  @@map("member_consents")
}

/// Minimal consent metadata for a specific eligibility notice. No identity evidence is stored.
model EligibilityConsent {
  id                           String                           @id @default(uuid()) @db.Uuid
  accountId                    String                           @map("account_id") @db.Uuid
  noticeVersion                String                           @map("notice_version") @db.VarChar(64)
  acceptedAt                   DateTime                         @default(now()) @map("accepted_at") @db.Timestamptz(6)
  biometricProcessingConsented Boolean                          @default(false) @map("biometric_processing_consented")
  source                       String                           @db.VarChar(32)
  account                      MemberAccount                    @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sessions                     EligibilityVerificationSession[]

  @@index([accountId, acceptedAt], map: "eligibility_consents_account_accepted_idx")
  @@map("eligibility_consents")
}

/// Provider session metadata only. Do not store documents, Aadhaar numbers, OTPs, selfies or biometric templates.
model EligibilityVerificationSession {
  id                String                               @id @default(uuid()) @db.Uuid
  accountId         String                               @map("account_id") @db.Uuid
  consentId         String                               @map("consent_id") @db.Uuid
  providerKey       String                               @map("provider_key") @db.VarChar(64)
  providerReference String?                              @map("provider_reference") @db.VarChar(255)
  status            EligibilityVerificationSessionStatus @default(CREATED)
  expiresAt         DateTime?                            @map("expires_at") @db.Timestamptz(6)
  completedAt       DateTime?                            @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime                             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                             @updatedAt @map("updated_at") @db.Timestamptz(6)
  account                MemberAccount                        @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  consent                EligibilityConsent                   @relation(fields: [consentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  providerCallbackEvents EligibilityProviderCallbackEvent[]

  @@unique([providerKey, providerReference], map: "eligibility_sessions_provider_reference_key")
  @@index([accountId, createdAt], map: "eligibility_sessions_account_created_idx")
  @@index([status, expiresAt], map: "eligibility_sessions_status_expiry_idx")
  @@map("eligibility_verification_sessions")
}

/// Stores callback event identifiers and normalized outcomes only. Raw callback
/// bodies and identity-provider payloads are never persisted.
model EligibilityProviderCallbackEvent {
  id              String                            @id @default(uuid()) @db.Uuid
  providerKey     String                            @map("provider_key") @db.VarChar(64)
  providerEventId String                            @map("provider_event_id") @db.VarChar(255)
  sessionId       String                            @map("session_id") @db.Uuid
  outcome         EligibilityProviderCallbackOutcome
  receivedAt      DateTime                          @default(now()) @map("received_at") @db.Timestamptz(6)
  session         EligibilityVerificationSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([providerKey, providerEventId], map: "eligibility_provider_callback_event_key")
  @@index([sessionId, receivedAt], map: "eligibility_provider_callback_session_received_idx")
  @@map("eligibility_provider_callback_events")
}

/// A minimal support/appeal intake. Category only; no free-text identity claims or uploaded evidence.
model EligibilitySupportRequest {
  id        String                           @id @default(uuid()) @db.Uuid
  accountId String                           @map("account_id") @db.Uuid
  category  EligibilitySupportRequestCategory
  status    EligibilitySupportRequestStatus  @default(OPEN)
  createdAt DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(6)
  account   MemberAccount                    @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([accountId, createdAt], map: "eligibility_support_account_created_idx")
  @@index([status, createdAt], map: "eligibility_support_status_created_idx")
  @@map("eligibility_support_requests")
}

/// Opaque bearer sessions. Only SHA-256 token digests are stored.
model AuthSession {
  id          String        @id @default(uuid()) @db.Uuid
  accountId   String        @map("account_id") @db.Uuid
  tokenDigest String        @unique(map: "auth_sessions_token_digest_key") @map("token_digest") @db.VarChar(64)
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime?     @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt  DateTime?     @map("last_seen_at") @db.Timestamptz(6)
  account     MemberAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([accountId, expiresAt], map: "auth_sessions_account_expiry_idx")
  @@index([expiresAt], map: "auth_sessions_expiry_idx")
  @@map("auth_sessions")
}

/// Stores the current product-update preference separately from required
/// Terms/Privacy acceptance. It is development/test only until its own
/// purpose and policy are approved for production.
model MemberCommunicationPreference {
  accountId              String        @id @map("account_id") @db.Uuid
  productUpdatesAccepted Boolean       @default(false) @map("product_updates_accepted")
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  account                MemberAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("member_communication_preferences")
}

model AuditEvent {
  id               String   @id @default(uuid()) @db.Uuid
  actorType        String   @map("actor_type") @db.VarChar(32)
  actorId          String?  @map("actor_id") @db.Uuid
  action           String   @db.VarChar(128)
  targetType       String?  @map("target_type") @db.VarChar(64)
  targetId         String?  @map("target_id") @db.VarChar(128)
  outcome          String   @db.VarChar(32)
  requestId        String   @map("request_id") @db.VarChar(128)
  redactedMetadata Json?    @map("redacted_metadata") @db.JsonB
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt], map: "audit_events_created_at_idx")
  @@index([actorType, actorId, createdAt], map: "audit_events_actor_created_idx")
  @@index([action, createdAt], map: "audit_events_action_created_idx")
  @@map("audit_events")
}
