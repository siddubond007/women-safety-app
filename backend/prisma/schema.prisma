generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  RESTRICTED
  SUSPENDED
  DELETED

  @@map("account_status")
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED

  @@map("verification_status")
}

enum EligibilitySubmissionStatus {
  PENDING_MANUAL_REVIEW
  APPROVED
  REJECTED

  @@map("eligibility_submission_status")
}

enum OtpPurpose {
  LOGIN
  REGISTRATION

  @@map("otp_purpose")
}

enum PolicyDocumentType {
  TERMS
  PRIVACY

  @@map("policy_document_type")
}

enum PolicyDocumentStatus {
  DRAFT
  PUBLISHED
  RETIRED

  @@map("policy_document_status")
}

enum ProfileVisibility {
  VERIFIED_MEMBERS
  FOLLOWERS_ONLY
  ONLY_ME

  @@map("profile_visibility")
}

enum MessagePermission {
  VERIFIED_MEMBERS
  FOLLOWING_ONLY
  NO_ONE

  @@map("message_permission")
}

enum PostAudience {
  VERIFIED_MEMBERS
  FOLLOWERS
  SELECTED_MEMBERS
  ONLY_ME

  @@map("post_audience")
}

enum LocationSharingMode {
  HIDDEN
  CITY_ONLY

  @@map("location_sharing_mode")
}

enum BusinessEnquiryPermission {
  ALL_VERIFIED
  VERIFIED_BUSINESSES
  NONE

  @@map("business_enquiry_permission")
}

enum MemberPostStatus {
  PUBLISHED
  HIDDEN
  REMOVED

  @@map("member_post_status")
}

enum MemberReportReason {
  HARASSMENT
  IMPERSONATION
  SPAM
  UNSAFE_CONTENT
  OTHER

  @@map("member_report_reason")
}

enum MemberReportStatus {
  OPEN
  REVIEWED
  CLOSED

  @@map("member_report_status")
}

enum BusinessProfileStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED

  @@map("business_profile_status")
}

enum AccountDeletionStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  CANCELLED

  @@map("account_deletion_status")
}

enum GroupVisibility {
  VERIFIED_MEMBERS
  PRIVATE

  @@map("group_visibility")
}

enum CommunityGroupStatus {
  ACTIVE
  ARCHIVED

  @@map("community_group_status")
}

enum GroupMemberRole {
  OWNER
  MODERATOR
  MEMBER

  @@map("group_member_role")
}

enum GroupMemberStatus {
  ACTIVE
  PENDING

  @@map("group_member_status")
}

enum CommunityEventStatus {
  DRAFT
  PUBLISHED
  CANCELLED

  @@map("community_event_status")
}

enum EventRegistrationStatus {
  REGISTERED
  CANCELLED

  @@map("event_registration_status")
}

model MemberAccount {
  id                      String                         @id @default(uuid()) @db.Uuid
  phoneE164               String                         @unique(map: "member_accounts_phone_e164_key") @map("phone_e164") @db.VarChar(16)
  phoneVerifiedAt         DateTime?                      @map("phone_verified_at") @db.Timestamptz(6)
  status                  AccountStatus                  @default(PENDING_VERIFICATION)
  verificationStatus      VerificationStatus             @default(UNVERIFIED) @map("verification_status")
  createdAt               DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  profile                 MemberProfile?
  otpChallenges           OtpChallenge[]
  consents                MemberConsent[]
  sessions                AuthSession[]
  communicationPreference MemberCommunicationPreference?
  eligibilitySubmissions EligibilitySubmission[]
  posts                 MemberPost[]
  postLikes             MemberPostLike[]
  postBookmarks         MemberPostBookmark[]
  postComments          MemberPostComment[]
  followsAsFollower     SocialFollow[]                 @relation("SocialFollowFollower")
  followsAsFollowing    SocialFollow[]                 @relation("SocialFollowFollowing")
  privacySettings       MemberPrivacySettings?
  notificationSettings  MemberNotificationPreferences?
  blockedAccounts       MemberBlock[]                  @relation("MemberBlockActor")
  blockedByAccounts     MemberBlock[]                  @relation("MemberBlockTarget")
  reportsFiled          MemberReport[]                 @relation("MemberReportReporter")
  reportsReceived       MemberReport[]                 @relation("MemberReportReported")
  businessProfile       BusinessProfile?
  deletionRequests      AccountDeletionRequest[]
  selectedPostAudience  PostAudienceMember[]           @relation("PostAudienceMemberAccount")
  createdCommunityGroups CommunityGroup[]               @relation("CommunityGroupCreator")
  groupMemberships       GroupMembership[]
  hostedCommunityEvents  CommunityEvent[]               @relation("CommunityEventHost")
  eventRegistrations     EventRegistration[]

  @@map("member_accounts")
}

model MemberProfile {
  accountId       String        @id @map("account_id") @db.Uuid
  displayName     String        @map("display_name") @db.VarChar(100)
  dateOfBirth     DateTime      @map("date_of_birth") @db.Date
  email           String?       @db.VarChar(254)
  profilePhotoRef String?       @map("profile_photo_ref") @db.VarChar(512)
  bio             String?       @db.VarChar(500)
  locationCity    String?       @map("location_city") @db.VarChar(100)
  interests       String[]      @default([])
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  account         MemberAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("member_profiles")
}

model OtpChallenge {
  id                String         @id @default(uuid()) @db.Uuid
  accountId         String?        @map("account_id") @db.Uuid
  phoneE164         String         @map("phone_e164") @db.VarChar(16)
  purpose           OtpPurpose
  providerReference String?        @map("provider_reference") @db.VarChar(255)
  codeDigest        String?        @map("code_digest") @db.VarChar(255)
  attemptCount      Int            @default(0) @map("attempt_count")
  attemptLimit      Int            @map("attempt_limit")
  expiresAt         DateTime       @map("expires_at") @db.Timestamptz(6)
  resendAvailableAt DateTime       @map("resend_available_at") @db.Timestamptz(6)
  consumedAt        DateTime?      @map("consumed_at") @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  account           MemberAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([phoneE164, purpose, createdAt], map: "otp_challenges_phone_purpose_created_idx")
  @@index([expiresAt], map: "otp_challenges_expires_at_idx")
  @@index([accountId], map: "otp_challenges_account_id_idx")
  @@map("otp_challenges")
}

model PolicyDocumentVersion {
  id           String               @id @default(uuid()) @db.Uuid
  documentType PolicyDocumentType   @map("document_type")
  version      String               @db.VarChar(64)
  status       PolicyDocumentStatus @default(DRAFT)
  contentHash  String?              @map("content_hash") @db.VarChar(128)
  effectiveAt  DateTime?            @map("effective_at") @db.Timestamptz(6)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  termsFor     MemberConsent[]      @relation("TermsAcceptedVersion")
  privacyFor   MemberConsent[]      @relation("PrivacyAcceptedVersion")

  @@unique([documentType, version], map: "policy_document_versions_type_version_key")
  @@index([documentType, status], map: "policy_document_versions_type_status_idx")
  @@map("policy_document_versions")
}

model MemberConsent {
  id               String                @id @default(uuid()) @db.Uuid
  accountId        String                @map("account_id") @db.Uuid
  termsVersionId   String                @map("terms_version_id") @db.Uuid
  privacyVersionId String                @map("privacy_version_id") @db.Uuid
  acceptedAt       DateTime              @default(now()) @map("accepted_at") @db.Timestamptz(6)
  source           String                @db.VarChar(64)
  account          MemberAccount         @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  termsVersion     PolicyDocumentVersion @relation("TermsAcceptedVersion", fields: [termsVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  privacyVersion   PolicyDocumentVersion @relation("PrivacyAcceptedVersion", fields: [privacyVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([accountId, acceptedAt], map: "member_consents_account_accepted_idx")
  @@index([termsVersionId], map: "member_consents_terms_version_idx")
  @@index([privacyVersionId], map: "member_consents_privacy_version_idx")
  @@map("member_consents")
}

/// Opaque bearer sessions. Only SHA-256 token digests are stored.
model AuthSession {
  id          String        @id @default(uuid()) @db.Uuid
  accountId   String        @map("account_id") @db.Uuid
  tokenDigest String        @unique(map: "auth_sessions_token_digest_key") @map("token_digest") @db.VarChar(64)
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime?     @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt  DateTime?     @map("last_seen_at") @db.Timestamptz(6)
  account     MemberAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([accountId, expiresAt], map: "auth_sessions_account_expiry_idx")
  @@index([expiresAt], map: "auth_sessions_expiry_idx")
  @@map("auth_sessions")
}

/// Stores the current product-update preference separately from required
/// Terms/Privacy acceptance. It is development/test only until its own
/// purpose and policy are approved for production.
model MemberCommunicationPreference {
  accountId              String        @id @map("account_id") @db.Uuid
  productUpdatesAccepted Boolean       @default(false) @map("product_updates_accepted")
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  account                MemberAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("member_communication_preferences")
}

model EligibilitySubmission {
  id                String                     @id @default(uuid()) @db.Uuid
  accountId         String                     @map("account_id") @db.Uuid
  status            EligibilitySubmissionStatus @default(PENDING_MANUAL_REVIEW)
  consentVersion    String                     @map("consent_version") @db.VarChar(64)
  consentAcceptedAt DateTime                   @map("consent_accepted_at") @db.Timestamptz(6)
  submittedAt       DateTime                   @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt        DateTime?                  @map("reviewed_at") @db.Timestamptz(6)
  reviewerLabel     String?                    @map("reviewer_label") @db.VarChar(80)
  decisionReason    String?                    @map("decision_reason") @db.VarChar(500)
  account           MemberAccount              @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([status, submittedAt], map: "eligibility_submissions_status_submitted_idx")
  @@index([accountId, submittedAt], map: "eligibility_submissions_account_submitted_idx")
  @@map("eligibility_submissions")
}

model AuditEvent {
  id               String   @id @default(uuid()) @db.Uuid
  actorType        String   @map("actor_type") @db.VarChar(32)
  actorId          String?  @map("actor_id") @db.Uuid
  action           String   @db.VarChar(128)
  targetType       String?  @map("target_type") @db.VarChar(64)
  targetId         String?  @map("target_id") @db.VarChar(128)
  outcome          String   @db.VarChar(32)
  requestId        String   @map("request_id") @db.VarChar(128)
  redactedMetadata Json?    @map("redacted_metadata") @db.JsonB
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt], map: "audit_events_created_at_idx")
  @@index([actorType, actorId, createdAt], map: "audit_events_actor_created_idx")
  @@index([action, createdAt], map: "audit_events_action_created_idx")
  @@map("audit_events")
}


/// User-authored text/photo-reference post. Media references are storage keys,
/// never caller-supplied arbitrary local paths.
model MemberPost {
  id              String                @id @default(uuid()) @db.Uuid
  accountId       String                @map("account_id") @db.Uuid
  body            String                @db.VarChar(5000)
  mediaRef        String?               @map("media_ref") @db.VarChar(512)
  audience        PostAudience          @default(VERIFIED_MEMBERS)
  status          MemberPostStatus      @default(PUBLISHED)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?             @map("deleted_at") @db.Timestamptz(6)
  account         MemberAccount         @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  likes           MemberPostLike[]
  bookmarks       MemberPostBookmark[]
  comments        MemberPostComment[]
  audienceMembers PostAudienceMember[]
  reports         MemberReport[]

  @@index([status, createdAt], map: "member_posts_status_created_idx")
  @@index([accountId, status, createdAt], map: "member_posts_account_status_created_idx")
  @@map("member_posts")
}

/// Exact audience allow-list for a post configured as SELECTED_MEMBERS.
model PostAudienceMember {
  postId    String        @map("post_id") @db.Uuid
  accountId String        @map("account_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  post      MemberPost    @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  account   MemberAccount @relation("PostAudienceMemberAccount", fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([postId, accountId])
  @@index([accountId, createdAt], map: "post_audience_members_account_created_idx")
  @@map("post_audience_members")
}

model MemberPostLike {
  postId    String        @map("post_id") @db.Uuid
  accountId String        @map("account_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  post      MemberPost    @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  account   MemberAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([postId, accountId])
  @@index([accountId, createdAt], map: "member_post_likes_account_created_idx")
  @@map("member_post_likes")
}

model MemberPostBookmark {
  postId    String        @map("post_id") @db.Uuid
  accountId String        @map("account_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  post      MemberPost    @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  account   MemberAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([postId, accountId])
  @@index([accountId, createdAt], map: "member_post_bookmarks_account_created_idx")
  @@map("member_post_bookmarks")
}

model MemberPostComment {
  id        String        @id @default(uuid()) @db.Uuid
  postId    String        @map("post_id") @db.Uuid
  accountId String        @map("account_id") @db.Uuid
  body      String        @db.VarChar(2000)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz(6)
  post      MemberPost    @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  account   MemberAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([postId, createdAt], map: "member_post_comments_post_created_idx")
  @@index([accountId, createdAt], map: "member_post_comments_account_created_idx")
  @@map("member_post_comments")
}

model SocialFollow {
  followerAccountId  String        @map("follower_account_id") @db.Uuid
  followingAccountId String        @map("following_account_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  follower           MemberAccount @relation("SocialFollowFollower", fields: [followerAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  following          MemberAccount @relation("SocialFollowFollowing", fields: [followingAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([followerAccountId, followingAccountId])
  @@index([followingAccountId, createdAt], map: "social_follows_following_created_idx")
  @@index([followerAccountId, createdAt], map: "social_follows_follower_created_idx")
  @@map("social_follows")
}

model MemberPrivacySettings {
  accountId                String                    @id @map("account_id") @db.Uuid
  profileVisibility        ProfileVisibility         @default(VERIFIED_MEMBERS) @map("profile_visibility")
  messagePermission         MessagePermission         @default(VERIFIED_MEMBERS) @map("message_permission")
  defaultPostAudience       PostAudience              @default(VERIFIED_MEMBERS) @map("default_post_audience")
  locationSharing           LocationSharingMode       @default(HIDDEN) @map("location_sharing")
  appearInSearch            Boolean                   @default(true) @map("appear_in_search")
  businessEnquiryPermission BusinessEnquiryPermission @default(VERIFIED_BUSINESSES) @map("business_enquiry_permission")
  updatedAt                 DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  account                   MemberAccount             @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("member_privacy_settings")
}

model MemberNotificationPreferences {
  accountId          String        @id @map("account_id") @db.Uuid
  communityUpdates   Boolean       @default(true) @map("community_updates")
  groupActivity      Boolean       @default(true) @map("group_activity")
  wellnessReminders  Boolean       @default(true) @map("wellness_reminders")
  safetyAlerts       Boolean       @default(true) @map("safety_alerts")
  messages           Boolean       @default(true)
  businessEnquiries  Boolean       @default(true) @map("business_enquiries")
  marketingUpdates   Boolean       @default(false) @map("marketing_updates")
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  account            MemberAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("member_notification_preferences")
}

model MemberBlock {
  blockerAccountId String        @map("blocker_account_id") @db.Uuid
  blockedAccountId String        @map("blocked_account_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  blocker          MemberAccount @relation("MemberBlockActor", fields: [blockerAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  blocked          MemberAccount @relation("MemberBlockTarget", fields: [blockedAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([blockerAccountId, blockedAccountId])
  @@index([blockedAccountId, createdAt], map: "member_blocks_target_created_idx")
  @@map("member_blocks")
}

model MemberReport {
  id                String             @id @default(uuid()) @db.Uuid
  reporterAccountId String             @map("reporter_account_id") @db.Uuid
  reportedAccountId String             @map("reported_account_id") @db.Uuid
  postId            String?            @map("post_id") @db.Uuid
  reason            MemberReportReason
  details           String?            @db.VarChar(1000)
  status            MemberReportStatus @default(OPEN)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedAt        DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  reporter          MemberAccount      @relation("MemberReportReporter", fields: [reporterAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reported          MemberAccount      @relation("MemberReportReported", fields: [reportedAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  post              MemberPost?        @relation(fields: [postId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status, createdAt], map: "member_reports_status_created_idx")
  @@index([reporterAccountId, createdAt], map: "member_reports_reporter_created_idx")
  @@map("member_reports")
}

model BusinessProfile {
  accountId   String               @id @map("account_id") @db.Uuid
  displayName String               @map("display_name") @db.VarChar(120)
  description String?              @db.VarChar(1000)
  websiteUrl  String?              @map("website_url") @db.VarChar(2048)
  status      BusinessProfileStatus @default(PENDING_REVIEW)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  account     MemberAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("business_profiles")
}

model AccountDeletionRequest {
  id            String                @id @default(uuid()) @db.Uuid
  accountId     String                @map("account_id") @db.Uuid
  status        AccountDeletionStatus @default(REQUESTED)
  requestedAt   DateTime              @default(now()) @map("requested_at") @db.Timestamptz(6)
  completedAt   DateTime?             @map("completed_at") @db.Timestamptz(6)
  requestReason String?               @map("request_reason") @db.VarChar(500)
  account       MemberAccount         @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([status, requestedAt], map: "account_deletion_requests_status_requested_idx")
  @@map("account_deletion_requests")
}


/// Member-led community spaces. Only verified members can create or join them.
model CommunityGroup {
  id                 String               @id @default(uuid()) @db.Uuid
  createdByAccountId String               @map("created_by_account_id") @db.Uuid
  name               String               @db.VarChar(120)
  slug               String               @unique @db.VarChar(160)
  description        String?              @db.VarChar(2000)
  visibility         GroupVisibility      @default(VERIFIED_MEMBERS)
  status             CommunityGroupStatus @default(ACTIVE)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  creator            MemberAccount        @relation("CommunityGroupCreator", fields: [createdByAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  members             GroupMembership[]
  events              CommunityEvent[]

  @@index([status, visibility, createdAt], map: "community_groups_status_visibility_created_idx")
  @@index([createdByAccountId, createdAt], map: "community_groups_creator_created_idx")
  @@map("community_groups")
}

model GroupMembership {
  groupId   String           @map("group_id") @db.Uuid
  accountId String           @map("account_id") @db.Uuid
  role      GroupMemberRole  @default(MEMBER)
  status    GroupMemberStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  group     CommunityGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  account   MemberAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([groupId, accountId])
  @@index([accountId, status, createdAt], map: "group_memberships_account_status_created_idx")
  @@index([groupId, status, role], map: "group_memberships_group_status_role_idx")
  @@map("group_memberships")
}

model CommunityEvent {
  id             String               @id @default(uuid()) @db.Uuid
  groupId        String               @map("group_id") @db.Uuid
  hostAccountId  String               @map("host_account_id") @db.Uuid
  title          String               @db.VarChar(160)
  description    String               @db.VarChar(3000)
  locationCity   String?              @map("location_city") @db.VarChar(100)
  startsAt       DateTime             @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime             @map("ends_at") @db.Timestamptz(6)
  status         CommunityEventStatus @default(PUBLISHED)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  group          CommunityGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  host           MemberAccount        @relation("CommunityEventHost", fields: [hostAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  registrations  EventRegistration[]

  @@index([status, startsAt], map: "community_events_status_starts_idx")
  @@index([groupId, status, startsAt], map: "community_events_group_status_starts_idx")
  @@map("community_events")
}

model EventRegistration {
  eventId   String                   @map("event_id") @db.Uuid
  accountId String                   @map("account_id") @db.Uuid
  status    EventRegistrationStatus  @default(REGISTERED)
  createdAt DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  event     CommunityEvent           @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  account   MemberAccount            @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([eventId, accountId])
  @@index([accountId, status, createdAt], map: "event_registrations_account_status_created_idx")
  @@map("event_registrations")
}
