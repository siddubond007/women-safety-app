{
  "name": "sakhi-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sakhi Stage 1 backend foundation (development and test only).",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "npm run build && node dist/main.js",
    "build": "node scripts/build.mjs",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "prisma generate && vitest run",
    "test:watch": "vitest",
    "test:db-integration": "prisma generate && vitest run test/auth.database.integration.spec.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\" \"*.ts\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\" \"*.ts\" \"*.json\" \"*.md\"",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "test:db-admin-review": "prisma generate && vitest run test/admin-review.database.integration.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@types/express": "5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "esbuild@0.28.2": true,
    "@scarf/scarf": false
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
