+          ? body.serviceArea.trim()
+          : (existing?.serviceArea ?? city),
+      priceRange:
+        typeof body.priceRange === "string" && body.priceRange.trim()
+          ? body.priceRange.trim()
+          : (existing?.priceRange ?? "₹500 – ₹2,500"),
