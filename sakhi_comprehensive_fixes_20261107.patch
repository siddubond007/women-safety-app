+  static async authenticateWithCredentials(
+    prisma: PrismaService,
+    dto: { identifier: string; password: string; ipAddress?: string; userAgent?: string },
+  ): Promise<{
+    authenticated: true;
+    sessionToken: string;
+    refreshToken: string;
+    csrfToken: string;
+    sessionExpiresAt: string;
+    mustResetPassword: boolean;
+    principal: AuthenticatedAdminPrincipal;
+  }> {
+    await this.ensureHydrated(prisma);
+    const identifier = String(dto.identifier ?? "").trim().toLowerCase();
+    const password = String(dto.password ?? "");
+    if (!identifier || !password) {
+      throw new UnauthorizedException("Enter both your admin email/username and password.");
+    }
+
+    const nowMs = Date.now();
+    const attemptState = this.loginAttemptMap.get(identifier) ?? {
+      count: 0,
+      lockedUntilMs: 0,
+    };
+    if (attemptState.lockedUntilMs > nowMs) {
+      const waitMinutes = Math.max(
+        1,
+        Math.ceil((attemptState.lockedUntilMs - nowMs) / 60000),
+      );
+      throw new ForbiddenException(
+        `This admin account is temporarily locked after repeated failed sign-in attempts. Try again in ${waitMinutes} minute(s).`,
+      );
+    }
+
+    // 1. Check environment-configured First Super Admin Bootstrap credentials (never hardcoded)
+    const bootstrapEmail = (
+      process.env.SAKHI_SUPER_ADMIN_BOOTSTRAP_EMAIL ?? ""
+    )
+      .trim()
+      .toLowerCase();
+    const bootstrapUsername = (
+      process.env.SAKHI_SUPER_ADMIN_BOOTSTRAP_USERNAME ?? ""
+    )
+      .trim()
+      .toLowerCase();
+    const bootstrapPassword =
+      process.env.SAKHI_SUPER_ADMIN_BOOTSTRAP_PASSWORD ?? "";
+
+    let matchedStaff: AdminStaffRecord | null = null;
+    let isBootstrapSuperAdmin = false;
+
+    if (
+      bootstrapPassword.length >= 10 &&
+      ((bootstrapEmail && identifier === bootstrapEmail) ||
+        (bootstrapUsername && identifier === bootstrapUsername))
+    ) {
+      const passBuf = Buffer.from(password, "utf8");
+      const expectedBuf = Buffer.from(bootstrapPassword, "utf8");
+      if (
+        passBuf.length === expectedBuf.length &&
+        timingSafeEqual(passBuf, expectedBuf)
+      ) {
+        isBootstrapSuperAdmin = true;
+      }
+    }
+
+    if (!isBootstrapSuperAdmin) {
+      for (const staff of this.staffMap.values()) {
+        const matchesEmail = staff.email.toLowerCase() === identifier;
+        const matchesUser =
+          staff.username && staff.username.toLowerCase() === identifier;
+        const matchesCode = staff.staffCode.toLowerCase() === identifier;
+        if (matchesEmail || matchesUser || matchesCode) {
+          matchedStaff = staff;
+          break;
+        }
+      }
+
+      if (matchedStaff) {
+        if (matchedStaff.lockedUntil) {
