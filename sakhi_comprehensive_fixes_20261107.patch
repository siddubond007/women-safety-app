+            targetType: "business_directory_listing",
+            targetId,
+            outcome: "deleted",
+            requestId: randomUUID(),
+            redactedMetadata: { id: targetId, deletedBy: actorLabel },
+          },
+        })
+        .catch(() => null);
+    }
+    return { deleted: true, businessId: targetId };
+  }
