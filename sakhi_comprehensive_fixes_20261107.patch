+    }
+    const profile = await fetchLocalRbacProfile(token);
+    inMemoryProfile = profile;
+    sessionStorage.setItem(LOCAL_PROFILE_KEY, JSON.stringify(profile));
+    return {
+      ...(data as AdminSession),
+      ...profile,
+    };
+  },
+  async authenticateWithCredentials(
+    identifier: string,
+    password: string,
+  ): Promise<AdminSession> {
+    const cleanId = identifier.trim();
+    if (!cleanId || !password) {
+      throw new Error("Enter both your admin email/username and password.");
+    }
+    const response = await fetch(`${API_BASE_URL}/admin-review/auth/login`, {
+      method: "POST",
+      headers: {
+        "Content-Type": "application/json",
+        Accept: "application/json",
+      },
+      body: JSON.stringify({ identifier: cleanId, password }),
+      credentials: "include",
+      cache: "no-store",
+    });
+    const data = (await response.json().catch(() => ({}))) as Partial<AdminSession> & {
+      message?: string | string[];
+    };
+    if (!response.ok || !data.sessionToken) {
+      const msg = Array.isArray(data.message) ? data.message.join(" ") : data.message;
+      throw new Error(msg || "Invalid admin email/username or password.");
+    }
+    const profile = extractProfileFromPayload(data);
+    inMemoryProfile = profile;
+    if (STAGING_TEST_ADMIN_MODE) {
+      stagingSessionToken = data.sessionToken;
+      stagingSessionMode = "staging_full_admin";
+    } else {
+      sessionStorage.setItem(LOCAL_TOKEN_KEY, data.sessionToken);
+      sessionStorage.setItem(LOCAL_PROFILE_KEY, JSON.stringify(profile));
+    }
+    return {
+      ...(data as AdminSession),
+      ...profile,
+    };
+  },
+  async authenticate(token: string): Promise<AdminSession> {
+    const session = await requestSession(token);
+    if (!STAGING_TEST_ADMIN_MODE) {
+      sessionStorage.setItem(LOCAL_TOKEN_KEY, token);
+    }
+    return session;
+  },
+  signOut(): void {
+    const activeToken = this.getToken();
+    if (activeToken) {
+      void fetch(`${API_BASE_URL}/admin-review/auth/logout`, {
+        method: "POST",
+        headers: {
+          "X-Sakhi-Admin-Token": activeToken,
+        },
+        credentials: "include",
+      }).catch(() => undefined);
+    }
+    inMemoryProfile = null;
+    if (STAGING_TEST_ADMIN_MODE) {
+      stagingSessionToken = null;
+      stagingSessionMode = null;
+    } else {
+      sessionStorage.removeItem(LOCAL_TOKEN_KEY);
+      sessionStorage.removeItem(LOCAL_PROFILE_KEY);
+    }
+  },
+};
