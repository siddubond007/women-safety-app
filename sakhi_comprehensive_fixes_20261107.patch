+  void _ensurePrimaryExists() {
+    if (trustedContacts.isEmpty) return;
+    if (!trustedContacts.any((c) => c.isPrimary)) {
+      trustedContacts.first.isPrimary = true;
+      trustedContacts.first.selectedForSosAlert = true;
+    }
