+
+export function hashAdminPassword(plainPassword: string): string {
+  const salt = randomBytes(16).toString("hex");
+  const derived = scryptSync(plainPassword, salt, 64, {
+    N: 16384,
+    r: 8,
+    p: 1,
+  }).toString("hex");
+  return `scrypt$16384$8$1$${salt}$${derived}`;
+}
+
+export function verifyAdminPassword(
+  plainPassword: string,
+  storedHash: string | null | undefined,
+): boolean {
+  if (!storedHash || !plainPassword) return false;
+  const parts = storedHash.split("$");
+  if (parts.length !== 6 || parts[0] !== "scrypt") return false;
+  const N = Number(parts[1]) || 16384;
+  const r = Number(parts[2]) || 8;
+  const p = Number(parts[3]) || 1;
+  const salt = parts[4] ?? "";
+  const expectedHex = parts[5] ?? "";
+  if (!salt || !expectedHex) return false;
+  try {
+    const derived = scryptSync(plainPassword, salt, 64, { N, r, p });
+    const expected = Buffer.from(expectedHex, "hex");
+    if (derived.length !== expected.length) return false;
+    return timingSafeEqual(derived, expected);
+  } catch {
+    return false;
+  }
+}
