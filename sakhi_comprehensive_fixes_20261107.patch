+      matchedStaff.failedLoginAttempts = 0;
+      matchedStaff.lockedUntil = null;
+      matchedStaff.lastLoginAt = new Date().toISOString();
+    }
+
+    const principal = isBootstrapSuperAdmin
+      ? this.getSuperAdminPrincipal(
+          process.env.SAKHI_ADMIN_REVIEWER_LABEL?.trim() || "Sakhi Super Admin",
+        )
+      : this.principalFromStaff(matchedStaff!);
+
+    const sessionId = randomUUID();
+    const rawSessionToken = `admin-session.${sessionId}.${randomBytes(24).toString("base64url")}`;
+    const rawRefreshToken = `admin-refresh.${sessionId}.${randomBytes(24).toString("base64url")}`;
+    const csrfToken = randomBytes(20).toString("hex");
+    const sessionTokenDigest = sha256Hex(rawSessionToken);
+    const refreshTokenDigest = sha256Hex(rawRefreshToken);
+    const expiresAtDate = new Date(nowMs + 4 * 3600 * 1000); // 4-hour session window
+
+    const sessRecord: AdminCredentialSessionRecord = {
+      id: sessionId,
+      staffId: principal.staffId,
+      sessionTokenDigest,
+      refreshTokenDigest,
+      csrfToken,
+      expiresAt: expiresAtDate.toISOString(),
+      revokedAt: null,
+      createdAt: new Date(nowMs).toISOString(),
+      lastRotatedAt: new Date(nowMs).toISOString(),
+    };
+    this.sessionMap.set(sessionTokenDigest, sessRecord);
+
+    const anyPrisma = prisma as unknown as Record<string, any>;
+    if (typeof anyPrisma.adminAuthSession?.create === "function") {
+      await anyPrisma.adminAuthSession
+        .create({
+          data: {
+            id: sessionId,
+            staffId: principal.staffId,
+            sessionTokenDigest,
+            refreshTokenDigest,
+            csrfToken,
+            ipAddressHash: dto.ipAddress ? sha256Hex(dto.ipAddress) : null,
+            userAgent: dto.userAgent?.slice(0, 255) ?? null,
+            expiresAt: expiresAtDate,
+          },
+        })
+        .catch(() => null);
+    }
+
+    if (prisma.auditEvent?.create) {
+      await prisma.auditEvent
+        .create({
+          data: {
+            actorType: "ADMIN",
+            action: "module10.admin_auth.login_succeeded",
+            targetType: "admin_staff_account",
+            targetId: principal.staffId,
+            outcome: "authenticated",
+            requestId: randomUUID(),
+            redactedMetadata: {
+              staffCode: principal.staffCode,
+              role: principal.role,
+              sessionId,
+            },
+          },
+        })
+        .catch(() => null);
+    }
+
+    return {
+      authenticated: true,
+      sessionToken: rawSessionToken,
+      refreshToken: rawRefreshToken,
+      csrfToken,
+      sessionExpiresAt: expiresAtDate.toISOString(),
+      mustResetPassword: Boolean(matchedStaff?.mustResetPassword ?? false),
+      principal,
+    };
+  }
+
+  static async revokeAdminSession(
+    prisma: PrismaService,
+    rawToken?: string,
+  ): Promise<{ signedOut: true }> {
+    const clean = (rawToken ?? "").trim();
+    if (clean) {
+      const digest = sha256Hex(clean);
+      const sess = this.sessionMap.get(digest);
+      if (sess) {
+        sess.revokedAt = new Date().toISOString();
+        this.sessionMap.delete(digest);
+      }
+      const anyPrisma = prisma as unknown as Record<string, any>;
+      if (typeof anyPrisma.adminAuthSession?.updateMany === "function") {
+        await anyPrisma.adminAuthSession
+          .updateMany({
+            where: { sessionTokenDigest: digest },
+            data: { revokedAt: new Date() },
+          })
+          .catch(() => null);
+      }
+    }
+    return { signedOut: true };
+  }
+
+  static async changeStaffPassword(
+    prisma: PrismaService,
+    staffId: string,
+    newPassword: string,
+    actorLabel: string,
+  ): Promise<{ updated: true; staffCode: string }> {
+    await this.ensureHydrated(prisma);
+    if (!newPassword || newPassword.trim().length < 10) {
+      throw new BadRequestException(
+        "New admin password must be at least 10 characters long.",
+      );
+    }
+    const existing =
+      this.staffMap.get(staffId) ??
+      Array.from(this.staffMap.values()).find((s) => s.staffCode === staffId);
+    if (!existing) {
+      throw new NotFoundException(`Admin staff account ${staffId} not found.`);
+    }
+    existing.passwordHash = hashAdminPassword(newPassword.trim());
+    existing.passwordUpdatedAt = new Date().toISOString();
+    existing.mustResetPassword = false;
+    existing.failedLoginAttempts = 0;
+    existing.lockedUntil = null;
+    existing.updatedAt = new Date().toISOString();
+    await this.persistStaffRecord(
+      prisma,
+      existing,
+      "password_updated",
+      actorLabel,
+    );
+    return { updated: true, staffCode: existing.staffCode };
+  }
+
+}
