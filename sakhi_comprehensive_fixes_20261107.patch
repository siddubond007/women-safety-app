+  Future<void> _pickAndUploadProfilePhoto(ImageSource source) async {
+    if (_profilePhotoUploading) return;
+    try {
+      final file = await _imagePicker.pickImage(
+        source: source,
+        maxWidth: 1600,
+        maxHeight: 1600,
+        imageQuality: 86,
+      );
+      if (file == null || !mounted) return;
+
+      final extension = file.name.toLowerCase().split('.').last;
+      final contentType = switch (extension) {
+        'jpg' || 'jpeg' => 'image/jpeg',
+        'png' => 'image/png',
+        'webp' => 'image/webp',
+        _ => null,
+      };
+      if (contentType == null) {
+        ScaffoldMessenger.of(context).showSnackBar(
+          const SnackBar(
+            content: Text('Choose a JPG, PNG, or WebP profile photo.'),
+          ),
+        );
+        return;
+      }
+      final rawBytes = await file.readAsBytes();
+      if (!mounted) return;
+      if (rawBytes.isEmpty || rawBytes.length > 8 * 1024 * 1024) {
+        ScaffoldMessenger.of(context).showSnackBar(
+          const SnackBar(
+            content: Text('Profile photos must be 8 MB or smaller.'),
+          ),
+        );
+        return;
+      }
+
+      final confirmedCrop = await _showSquareCropAndExifPreviewDialog(
+        rawBytes,
+        file.name,
+      );
+      if (confirmedCrop != true || !mounted) return;
+      final bytes = _stripJpegExifSegments(rawBytes);
+
+      setState(() => _profilePhotoUploading = true);
+      final result = await SakhiPrototypeState.instance.uploadMediaFile(
+        purpose: 'avatar',
+        fileName: file.name,
+        fileBytes: bytes,
+        contentType: contentType,
+      );
+      if (!mounted) return;
+      if (result == null || (result['mediaUrl'] ?? '').isEmpty) {
+        ScaffoldMessenger.of(context).showSnackBar(
+          const SnackBar(
+            content: Text(
+              'The profile photo was not uploaded. Check your connection and retry.',
+            ),
+          ),
+        );
+        return;
+      }
+      ScaffoldMessenger.of(
+        context,
+      ).showSnackBar(const SnackBar(content: Text('Profile photo updated.')));
+    } catch (_) {
+      if (mounted) {
+        ScaffoldMessenger.of(context).showSnackBar(
+          const SnackBar(
+            content: Text(
+              'Could not access or upload that photo. Check app permissions and retry.',
+            ),
+          ),
+        );
+      }
+    } finally {
+      if (mounted) setState(() => _profilePhotoUploading = false);
+    }
+  }
