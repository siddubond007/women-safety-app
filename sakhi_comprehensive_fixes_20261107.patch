+            matchedStaff.lockedUntil = new Date(lockUntil).toISOString();
+          }
+        }
+        if (prisma.auditEvent?.create) {
+          await prisma.auditEvent
+            .create({
+              data: {
+                actorType: "ADMIN",
+                action:
+                  lockUntil > 0
+                    ? "module10.admin_auth.account_locked"
+                    : "module10.admin_auth.login_failed",
+                targetType: "admin_staff_account",
+                targetId: matchedStaff?.id ?? "unknown",
+                outcome: "denied",
+                requestId: randomUUID(),
+                redactedMetadata: {
+                  identifierHash: sha256Hex(identifier).slice(0, 16),
+                  attemptCount: nextCount,
+                  locked: lockUntil > 0,
+                },
+              },
