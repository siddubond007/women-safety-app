+        w * 0.50,
+        h * 0.57 - breathY,
+      )
+      ..quadraticBezierTo(
+        w * 0.73,
+        h * 0.58 - breathY,
+        w * 0.78,
+        h * 0.98,
+      )
+      ..close();
+    canvas.drawPath(
+      torsoPath,
+      Paint()
+        ..shader = const LinearGradient(
+          begin: Alignment.topLeft,
+          end: Alignment.bottomRight,
+          colors: [Color(0xFFD63E85), Color(0xFF7B228E)],
+        ).createShader(Rect.fromLTWH(0, h * 0.55, w, h * 0.45)),
