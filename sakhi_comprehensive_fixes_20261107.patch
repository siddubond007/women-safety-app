+  Widget _buildPostGrid(
+    BuildContext context,
+    SakhiPrototypeState state,
+    List<FeedPostModel> posts, {
+    required bool isSavedGrid,
+  }) {
+    return LayoutBuilder(
+      builder: (context, constraints) {
+        final columns = constraints.maxWidth >= 560 ? 4 : 3;
+        return GridView.builder(
+          padding: EdgeInsets.zero,
+                  shrinkWrap: true,
+          physics: const NeverScrollableScrollPhysics(),
+          itemCount: posts.length,
+          gridDelegate: SliverGridDelegateWithFixedCrossAxisCount(
+            crossAxisCount: columns,
+            crossAxisSpacing: 8,
+            mainAxisSpacing: 8,
+            childAspectRatio: 1,
+          ),
+          itemBuilder: (context, index) {
+            final post = posts[index];
+            final source = post.imageAsset?.trim() ?? '';
+            final isVideo = (post.mediaContentType ?? '').contains('video');
+            Widget thumbnail;
+            if (source.isEmpty) {
+              thumbnail = Container(
+                padding: const EdgeInsets.all(10),
+                decoration: BoxDecoration(
+                  gradient: const LinearGradient(
+                    begin: Alignment.topLeft,
+                    end: Alignment.bottomRight,
+                    colors: [Color(0xFFFDF2F7), Color(0xFFF3E6FA)],
+                  ),
+                  border: Border.all(color: AppColors.borderSubtle),
+                ),
+                child: Column(
+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
+                  children: [
+                    Container(
+                      padding: const EdgeInsets.symmetric(
+                        horizontal: 6,
+                        vertical: 2,
+                      ),
+                      decoration: BoxDecoration(
+                        color: Colors.white.withValues(alpha: 0.85),
+                        borderRadius: BorderRadius.circular(99),
+                      ),
+                      child: Text(
+                        (post.categoryBadge ?? post.categorySlug).replaceAll(
+                          '_',
+                          ' ',
+                        ),
+                        maxLines: 1,
+                        overflow: TextOverflow.ellipsis,
+                        style: const TextStyle(
+                          fontSize: 8.5,
+                          fontWeight: FontWeight.w800,
+                          color: AppColors.primaryPurple,
+                        ),
+                      ),
+                    ),
+                    Expanded(
+                      child: Padding(
+                        padding: const EdgeInsets.symmetric(vertical: 4),
+                        child: Text(
+                          post.content.trim().isNotEmpty
+                              ? post.content.trim()
+                              : 'Community Post',
+                          maxLines: 4,
+                          overflow: TextOverflow.ellipsis,
+                          style: const TextStyle(
+                            fontSize: 10.5,
+                            height: 1.25,
+                            fontWeight: FontWeight.w600,
+                            color: AppColors.textPrimary,
+                          ),
+                        ),
+                      ),
+                    ),
+                    Row(
+                      children: [
+                        const Icon(
+                          Icons.favorite_rounded,
+                          size: 11,
+                          color: AppColors.heartPink,
+                        ),
+                        const SizedBox(width: 3),
+                        Text(
+                          '${post.likesCount}',
+                          style: const TextStyle(
+                            fontSize: 9.5,
+                            fontWeight: FontWeight.w700,
+                            color: AppColors.textSecondary,
+                          ),
+                        ),
+                        const SizedBox(width: 8),
+                        const Icon(
+                          Icons.chat_bubble_outline_rounded,
+                          size: 11,
+                          color: AppColors.primaryPurple,
+                        ),
+                        const SizedBox(width: 3),
+                        Text(
+                          '${post.comments.isNotEmpty ? post.comments.length : post.commentsCount}',
+                          style: const TextStyle(
+                            fontSize: 9.5,
+                            fontWeight: FontWeight.w700,
+                            color: AppColors.textSecondary,
+                          ),
+                        ),
+                      ],
+                    ),
+                  ],
+                ),
+              );
+            } else if (source.startsWith('http://') ||
+                source.startsWith('https://') ||
+                source.startsWith('/api/v1/')) {
+              thumbnail = SakhiRemoteMediaImage(source: source);
+            } else {
+              thumbnail = Image.asset(
+                source,
+                fit: BoxFit.cover,
+                errorBuilder: (_, _, _) => Container(
+                  color: AppColors.pastelPink,
+                  alignment: Alignment.center,
+                  child: const Icon(Icons.broken_image_outlined),
+                ),
+              );
+            }
+            return Semantics(
+              button: true,
+              label: 'Open post by ${post.authorName}',
+              child: InkWell(
+                borderRadius: BorderRadius.circular(12),
+                onTap: () => showDialog<void>(
+                  context: context,
+                  builder: (dialogContext) => Dialog(
+                    backgroundColor: Colors.transparent,
+                    insetPadding: const EdgeInsets.symmetric(
+                      horizontal: 14,
+                      vertical: 24,
+                    ),
+                    child: AnimatedBuilder(
+                      animation: state,
+                      builder: (context, _) => SingleChildScrollView(
+                        padding: const EdgeInsets.all(4),
+                        child: FeedPostCard(
+                          post: post,
+                          showVerifiedCheck: true,
+                          onLikeTap: () => state.togglePostLike(post),
+                          onSaveTap: () async {
+                            final ok = await state.togglePostSaved(post);
+                            if (mounted) {
+                              setState(() {
+                                if (!post.isSaved) {
+                                  _savedPosts = _savedPosts
+                                      .where((p) => p.id != post.id)
+                                      .toList(growable: false);
+                                }
+                              });
+                            }
+                            if (isSavedGrid &&
+                                !post.isSaved &&
+                                dialogContext.mounted) {
+                              Navigator.of(dialogContext).pop();
+                            }
+                            return ok;
+                          },
+                        ),
+                      ),
+                    ),
+                  ),
+                ),
+                child: ClipRRect(
+                  borderRadius: BorderRadius.circular(12),
+                  child: Stack(
+                    fit: StackFit.expand,
+                    children: [
+                      thumbnail,
+                      if (isVideo)
+                        Center(
+                          child: Container(
+                            width: 32,
+                            height: 32,
+                            decoration: BoxDecoration(
+                              color: Colors.black.withValues(alpha: 0.55),
+                              shape: BoxShape.circle,
+                            ),
+                            child: const Icon(
+                              Icons.play_arrow_rounded,
+                              color: Colors.white,
+                              size: 20,
+                            ),
+                          ),
+                        ),
+                      if (source.isNotEmpty)
+                        Positioned(
+                          right: 6,
+                          top: 6,
+                          child: DecoratedBox(
+                            decoration: BoxDecoration(
+                              color: Colors.black.withValues(alpha: 0.45),
+                              borderRadius: BorderRadius.circular(6),
+                            ),
+                            child: Padding(
+                              padding: const EdgeInsets.all(4),
+                              child: Icon(
+                                isSavedGrid
+                                    ? Icons.bookmark_rounded
+                                    : Icons.collections_outlined,
+                                color: Colors.white,
+                                size: 13,
+                              ),
+                            ),
+                          ),
+                        ),
+                    ],
+                  ),
+                ),
+              ),
+            );
+          },
+        );
+      },
+    );
+  }
