+        // State == ARMED_AWAITING_VOLUME_DOWN
+        if (keyCode == KeyEvent.KEYCODE_VOLUME_DOWN) {
+            if (volumeDownTaps.isNotEmpty()) {
+                val gap = nowMs - volumeDownTaps.last()
+                if (gap < minInterTapGapMs || gap > maxInterTapGapMs) {
+                    volumeDownTaps.clear()
+                }
